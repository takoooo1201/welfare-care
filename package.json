{
  "name": "welfare-care",
  "private": true,
  "version": "0.1.0",
  "description": "福利找上門：城市通（TownPass）福利媒合與關懷微服務",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "PORT=8787 node --watch server/index.ts",
    "dev:web": "vite --port 5173 --strictPort",
    "build": "vite build",
    "typecheck": "vue-tsc -b",
    "start": "node server/index.ts",
    "test": "node --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "leaflet": "^1.9.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  }
}
